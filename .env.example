# Copia este archivo como .env.local y rellena los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.

# --- Base de datos (fase 7) ---
# Cadena de conexión que da Aiven en el panel del servicio.
# Postgres:  postgres://usuario:clave@host:puerto/defaultdb?sslmode=require
# MySQL:     mysql://usuario:clave@host:puerto/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=

# Sólo si Aiven te da un certificado ca.pem y hace falta verificarlo.
# Guarda el archivo fuera del repositorio y pon aquí su ruta.
# DATABASE_CA_CERT_PATH=

# --- Acceso a la vista de equipo (fase 7) ---
# Hoy la clave está escrita en src/lib/team.ts, que viaja al navegador.
# Al montar la autenticación real pasa a vivir aquí.
# TEAM_PASSWORD=

# --- Entrar con Google ---
# Del panel de Google Cloud → Credenciales → ID de cliente de OAuth (web).
# Es público por diseño: va en el navegador. No hace falta el secreto de
# cliente, porque se usa el flujo de token de identidad.
# En "Orígenes autorizados de JavaScript" hay que poner cada dominio desde el
# que se abrirá el botón, incluido http://localhost:3000 para desarrollo.
# Sin esto, la tienda funciona igual: sólo desaparece el botón de Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Pagos en línea: Bold (fase 6) ---
# Las dos llaves salen del panel de Bold (bold.co) → Integraciones → "Llaves de
# integración". Hay un par de PRUEBAS y otro de PRODUCCIÓN: no los mezcles, Bold
# da error si la identidad es de un ambiente y la secreta de otro.
# Sin la llave de identidad, la tienda funciona igual: sólo desaparece "pagar en
# línea" y todo se cobra al recibir o al recoger.
#
# "Llave de identidad" (Bold la llama también API key). Con ella el servidor
# crea los links de pago y consulta su estado.
BOLD_API_KEY=
# "Llave secreta". Sólo firma los avisos del webhook; nunca sale del servidor.
# Bold documenta que en modo pruebas firma con la llave VACÍA: para probar el
# webhook con el botón "Probar el webhook" del checkout de pruebas, déjala así:
#   BOLD_SECRET_KEY=
# En producción pon la de verdad.
BOLD_SECRET_KEY=
# La URL que hay que registrar en Bold → Integraciones → "Configurar webhook";
# tiene que ser pública y con HTTPS:
#   https://TU-DOMINIO/api/bold/webhook
# En modo pruebas Bold NO manda webhooks solo; la tienda confirma el pago al
# volver el cliente, así que igual funciona.
# Tarjetas de prueba: aprobada 4111 1111 1111 1111 (Visa) o 5100 0100 0000 0015
# (Mastercard) · rechazada 4970 1100 0000 0062 · con error 5204 7300 0000 8404.
# PSE de prueba: banco "BANCO QUE APRUEBA" / "BANCO QUE RECHAZA".

# URL pública del sitio, para que la pasarela sepa a dónde devolver al cliente.
# En local se deduce sola; en producción conviene ponerla.
# OJO: Bold sólo devuelve al cliente a una URL https. En local (http) el link
# se crea sin vuelta automática: tras pagar, abre a mano
# http://localhost:3000/checkout/listo?pedido=B-xxxx (el número sale en la
# descripción del pago). Si quieres la vuelta automática en local, levanta un
# túnel (p. ej. `npx cloudflared tunnel --url http://localhost:3000`) y pon
# aquí la URL https que te dé.
# NEXT_PUBLIC_SITE_URL=https://www.blendlabco.co

# --- Cloudinary: fotos y videos de la tienda ---
# Salen del panel de Cloudinary → Settings → API Keys.
# El navegador sube el archivo directo a Cloudinary con una firma que genera el
# servidor, así que el secreto nunca llega al cliente. En la base sólo queda la
# URL; el tamaño y el formato se deciden al pintar (src/lib/media.ts).
# Sin estas tres, la tienda funciona igual: el editor sólo deja pegar URLs.
# OJO: este archivo SÍ se sube al repositorio. Los valores reales van en
# .env.local, que está en .gitignore. Aquí sólo los nombres, vacíos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --- Google Search Console ---
# Al verificar la propiedad con el método «Etiqueta HTML», Google da una
# etiqueta <meta name="google-site-verification" content="XXXX">. Aquí va sólo
# el contenido (XXXX). Ponla en Vercel (Production); en local no hace falta.
# GOOGLE_SITE_VERIFICATION=
